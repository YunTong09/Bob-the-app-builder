# Copy this file to backend/.env and fill credentials locally.
# The backend loads backend/.env at startup. Existing process variables win.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
R2R_AI_MODE=claude
R2R_SERVICES=real

# Must exactly match the frontend browser URL, including port.
R2R_WEB_ORIGIN=http://127.0.0.1:3000

# Optional: enable previewing the one configured Slack test channel.
SLACK_BOT_TOKEN=
R2R_SLACK_CHANNEL_ID=
