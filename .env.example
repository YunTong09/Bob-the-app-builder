ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
USE_MOCK=true

# Slack bot token: used by Socket Mode and the optional FastAPI channel preview.
# npm run slack:start loads .env.slack.local; FastAPI needs process environment variables.
SLACK_BOT_TOKEN=

# Slack Socket Mode only; not required for FastAPI history preview.
SLACK_APP_TOKEN=

# Web App local integration. Use false to call FastAPI instead of the browser mock.
NEXT_PUBLIC_R2R_MOCK=true
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Set on the FastAPI process to the exact local Next.js origin.
R2R_WEB_ORIGIN=http://127.0.0.1:3000

# FastAPI history preview: the one allowed Slack channel (e.g. C0123456789).
R2R_SLACK_CHANNEL_ID=
