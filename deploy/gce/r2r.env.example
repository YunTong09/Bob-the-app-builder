# Copy to /etc/r2r/r2r.env on the VM. Non-secret settings only: the Claude key,
# invite list and session secret come from Secret Manager (start-backend.sh).
R2R_APP_DIR=/home/YOUR_USER/Bob-the-app-builder
R2R_PUBLIC_ORIGIN=https://example.com
ANTHROPIC_MODEL=claude-opus-5-5
R2R_AI_MODE=claude
R2R_SERVICES=real

# Optional limits (defaults shown).
R2R_GENERATE_LIMIT_PER_HOUR=30
R2R_LOGIN_FAILURES_PER_15_MIN=10
R2R_SESSION_TTL_HOURS=168
