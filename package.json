{
  "name": "rage-to-reply",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:backend": "python3 -m compileall -q -x \"[.]venv|__pycache__\" backend",
    "lint": "next lint",
    "slack:start": "node --env-file-if-exists=.env.slack.local slack/app.mts",
    "slack:typecheck": "tsc --noEmit --strict --skipLibCheck --module NodeNext --resolveJsonModule --allowImportingTsExtensions slack/*.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@slack/bolt": "^5.1.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
}
